{
  "name": "@rohan9024/llmrouter",
  "version": "2.0.1",
  "description": "Zero-dependency, in-process TypeScript LLM router with intelligent multi-provider failover, retries, circuit breakers, cost-aware routing, and agent-first CLI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "llmrouter": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters.d.ts",
        "default": "./dist/adapters.js"
      },
      "require": {
        "types": "./dist/adapters.d.cts",
        "default": "./dist/adapters.cjs"
      }
    },
    "./catalog": {
      "import": {
        "types": "./dist/catalog.d.ts",
        "default": "./dist/catalog.js"
      },
      "require": {
        "types": "./dist/catalog.d.cts",
        "default": "./dist/catalog.cjs"
      }
    },
    "./benchmark": {
      "import": {
        "types": "./dist/benchmark.d.ts",
        "default": "./dist/benchmark.js"
      },
      "require": {
        "types": "./dist/benchmark.d.cts",
        "default": "./dist/benchmark.cjs"
      }
    }
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohan9024/llmrouter.git"
  },
  "homepage": "https://github.com/rohan9024/llmrouter#readme",
  "bugs": {
    "url": "https://github.com/rohan9024/llmrouter/issues"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "llm",
    "llm-router",
    "llm-routing",
    "ai-router",
    "typescript",
    "nodejs",
    "openai",
    "anthropic",
    "gemini",
    "groq",
    "ollama",
    "provider-failover",
    "llm-fallback",
    "circuit-breaker",
    "ai-agents",
    "cost-optimization"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  }
}
